$ curl -X POST http://localhost:9092/mcp -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" -H "x-tenant-id: acme" -d '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"getOrders","arguments":{"status":"shipped"}}}'
{"jsonrpc":"2.0", "id":1, "result":{"content":[{"type":"text", "text":"[{\"id\":\"ORD-1001\",\"tenantId\":\"acme\",\"status\":\"shipped\",\"total\":120.50}]"}]}}

